# 스테이징 웹 빌드(vite build --mode staging)에 들어가는 공개 값. 비밀값을 넣지 않는다.
# anon key는 RLS가 막는 공개 키다. service_role 키는 절대 넣지 않는다.
# REPLACE_ME가 남아 있으면 배포 워크플로가 멈춘다. 값은 docs/deploy.md "Leo가 먼저 할 일" 6에서 채운다.
VITE_SUPABASE_URL=https://REPLACE_ME_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME_STAGING_ANON_KEY
VITE_AGENT_URL=https://REPLACE_ME_AGENT_STAGING_URL.run.app
VITE_ENV_LABEL=staging
